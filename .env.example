# ---------------------------------------------------------------------------
# Nellvia environment variables
# Copy to .env.local and fill in. Never commit real values.
# ---------------------------------------------------------------------------

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Extra hosts allowed to invoke server actions, comma separated, no scheme.
# Needed when the app is reached through a host Next.js does not already know
# (a tunnel, a preview domain, a custom domain). Without it the UI renders but
# every form silently fails with a 500.
# SERVER_ACTION_ORIGINS=demo.nellvia.com,my-tunnel.trycloudflare.com

# Supabase --------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI ----------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Stripe ----------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_COACH=
STRIPE_PRICE_PRO=
STRIPE_PRICE_SCALE=

# Resend ----------------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL="Nellvia <hello@nellvia.com>"

# PostHog ---------------------------------------------------------------------
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Sentry ----------------------------------------------------------------------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Scheduled jobs (nightly pattern/alert recompute, weekly emails) --------------
CRON_SECRET=
